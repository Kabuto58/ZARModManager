<Window x:Class="ZARModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZARModManager.ViewModels"
        Title="ZARModManager" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource B.Bg}" Icon="Assets/zaloader.ico"
        FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}" AllowDrop="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- a status dot, coloured by a Tone (Tag) -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource B.TextFaint}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Ok}"><Setter Property="Fill" Value="{StaticResource B.Ok}"/></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Warn}"><Setter Property="Fill" Value="{StaticResource B.Accent}"/></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:Tone.Danger}"><Setter Property="Fill" Value="{StaticResource B.Danger}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource T.Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- skeleton row: a soft shimmer while the library is read -->
        <Style x:Key="Skeleton" TargetType="Border">
            <Setter Property="Height" Value="86"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource B.Panel}"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource B.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================================= title bar == -->
        <Grid Grid.Row="0" Background="{StaticResource B.Sidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1"/>
            <Grid Width="22" Height="22">
                <Path Data="{StaticResource I.Logo}" Stroke="{StaticResource B.Accent}" StrokeThickness="1.8" Stretch="Uniform" StrokeLineJoin="Round"/>
                <Path Data="{StaticResource I.Bolt}" Fill="{StaticResource B.Accent}" Stretch="Uniform" Margin="6.5,5"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="// ZARMODMANAGER" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Text}"/>
                <TextBlock Text="  /  " FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.TextFaint}"/>
                <TextBlock x:Name="PageTitle" Text="HOME" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Accent}"/>
                <Border Style="{StaticResource Badge}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding AppVersion}" FontFamily="{StaticResource F.Mono}" FontSize="10" Foreground="{StaticResource B.Accent}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Caption}" Click="Minimize_Click" ToolTip="Minimise">
                    <Path Data="{StaticResource I.Min}" Style="{StaticResource Path.Icon}" Width="12" Height="12" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource Btn.Caption}" Click="Maximize_Click" ToolTip="Maximise">
                    <Path Data="{StaticResource I.Max}" Style="{StaticResource Path.Icon}" Width="11" Height="11" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource Btn.CaptionClose}" Click="Close_Click" ToolTip="Close">
                    <Path Data="{StaticResource I.Close}" Style="{StaticResource Path.Icon}" Width="12" Height="12" StrokeThickness="1.2"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================================= icon rail == -->
            <Border Background="{StaticResource B.Sidebar}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,12">
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" ToolTip="{Binding GameStatus}" Margin="0,0,0,6">
                        <Ellipse x:Name="RunDot" Style="{StaticResource Dot}" Tag="{Binding GameTone}" Width="8" Height="8"/>
                        <TextBlock Text="GAME" FontFamily="{StaticResource F.Mono}" FontSize="9" Foreground="{StaticResource B.TextFaint}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True" Tag="Home" Checked="Nav_Checked" ToolTip="Home">
                            <Path Data="{StaticResource I.Home}" Style="{StaticResource Path.Icon}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavMods" Style="{StaticResource Nav}" GroupName="Nav" Tag="Mods" Checked="Nav_Checked" ToolTip="Mods">
                            <Path Data="{StaticResource I.Mods}" Style="{StaticResource Path.Icon}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" GroupName="Nav" Tag="Logs" Checked="Nav_Checked" ToolTip="Logs">
                            <Path Data="{StaticResource I.Logs}" Style="{StaticResource Path.Icon}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="Nav" Tag="Settings" Checked="Nav_Checked" ToolTip="Settings">
                            <Path Data="{StaticResource I.Settings}" Style="{StaticResource Path.Icon}"/>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================================= pages == -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <Rectangle Fill="{StaticResource B.Grid}" IsHitTestVisible="False"/>

                <!-- ========================================================================= HOME -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                    <Grid Margin="40,34,40,40" MaxWidth="1240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="// ZOMBIE ASSAULT: RESURGENCE" Style="{StaticResource T.Eyebrow}"/>
                            <TextBlock Text="Launch with mods" Style="{StaticResource T.Title}" Margin="0,8,0,10"/>
                            <TextBlock Style="{StaticResource T.Body}" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="ZARModManager puts its runtime in the game folder and loads every enabled mod when the game starts. Each mod's settings are changed in game: Settings, then the MODS tab."/>

                            <WrapPanel Margin="0,22,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GAME" Style="{StaticResource T.Mono}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <Ellipse Style="{StaticResource Dot}" Tag="{Binding GameTone}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding GameStatus}" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="LOADER" Style="{StaticResource T.Mono}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <Ellipse Style="{StaticResource Dot}" Tag="{Binding LoaderTone}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding LoaderStatus}" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="MODS" Style="{StaticResource T.Mono}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" FontFamily="{StaticResource F.Mono}"/><Run Text=" enabled"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- launch strip -->
                            <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource B.Hazard}"/>
                                    <DockPanel Grid.Column="1" Margin="22,20">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenModsFolderCommand}" Margin="0,0,10,0" ToolTip="Open the game's ZAMods folder">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource I.Folder}" Style="{StaticResource Path.Icon}" Width="15" Height="15" Margin="0,0,8,0"/>
                                                    <TextBlock Text="MODS FOLDER" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding LaunchCommand}" Height="44" Padding="22,0" MinWidth="190">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource I.Play}" Fill="{StaticResource B.AccentInk}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding LaunchLabel}" VerticalAlignment="Center" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ready to deploy" Style="{StaticResource T.H2}"/>
                                            <TextBlock Style="{StaticResource T.Mono}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="via Steam  ·  "/><Run Text="{Binding EnabledCount, Mode=OneWay}"/><Run Text=" mods load"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- installed mods, at a glance -->
                            <DockPanel Margin="0,34,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Height="28" Padding="10,0" FontSize="11"
                                        Click="GoMods_Click" Content="MANAGE"/>
                                <TextBlock Text="// INSTALLED MODS" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Mods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="18,13">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource T.Mono}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="Version"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Ellipse Style="{StaticResource Dot}" Margin="0,0,12,0">
                                                            <Ellipse.Tag>
                                                                <Binding Path="Enabled">
                                                                    <Binding.Converter><vm:EnabledTone/></Binding.Converter>
                                                                </Binding>
                                                            </Ellipse.Tag>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="20,22" Visibility="{Binding HasMods, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                        <TextBlock Text="No mods installed yet" Style="{StaticResource T.H2}" FontSize="15"/>
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0"
                                                   Text="Drop mod .lua files anywhere on this window, or use Install Mod on the Mods page."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- right column: the loader runtime -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Panel}" Padding="20,18">
                                <StackPanel>
                                    <TextBlock Text="// LOADER RUNTIME" Style="{StaticResource SectionHead}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Installed" Style="{StaticResource T.Mono}" Margin="0,0,16,8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontFamily="{StaticResource F.Mono}" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="Included" Style="{StaticResource T.Mono}" Margin="0,0,16,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BundledVersion}" FontFamily="{StaticResource F.Mono}" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Text="Folder" Style="{StaticResource T.Mono}" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GameDirText}" FontFamily="{StaticResource F.Mono}" FontSize="11"
                                                   Foreground="{StaticResource B.TextDim}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding GameDirText}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding InstallRuntimeCommand}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Visibility="{Binding CanInstallRuntime, Converter={StaticResource Vis}}" Content="INSTALL / UPDATE"/>
                                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenGameFolderCommand}" Height="32" Padding="12,0" Content="GAME FOLDER"
                                                IsEnabled="{Binding GameFound}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ========================================================================= MODS -->
                <ScrollViewer x:Name="PageMods" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                    <StackPanel Margin="40,34,40,40" MaxWidth="1000" HorizontalAlignment="Left">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Btn.Icon}" Command="{Binding RefreshCommand}" ToolTip="Read the mods folder again" Margin="0,0,8,0">
                                    <Path Data="{StaticResource I.Refresh}" Style="{StaticResource Path.Icon}" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding ImportCommand}" IsEnabled="{Binding GameFound}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource I.Plus}" Stroke="{StaticResource B.AccentInk}" StrokeThickness="2" Stretch="Uniform" Width="11" Height="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="INSTALL MOD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="// LIBRARY" Style="{StaticResource T.Eyebrow}"/>
                                <TextBlock Text="Mods" Style="{StaticResource T.Title}" Margin="0,8,0,6"/>
                                <TextBlock Style="{StaticResource T.Mono}">
                                    <Run Text="{Binding EnabledCount, Mode=OneWay}" Foreground="{StaticResource B.Text}"/><Run Text=" enabled  ·  "/><Run Text="{Binding DisabledCount, Mode=OneWay}" Foreground="{StaticResource B.Text}"/><Run Text=" disabled  ·  drop mod .lua files anywhere to install"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <!-- no game folder -->
                        <Border Style="{StaticResource Panel}" Margin="0,24,0,0" Padding="22,18" BorderBrush="#4A2A2A"
                                Visibility="{Binding GameFound, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="SETTINGS" Click="GoSettings_Click" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource I.Warn}" Stroke="{StaticResource B.Danger}" Style="{StaticResource Path.Icon}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Game folder not found" Style="{StaticResource T.H2}" FontSize="15"/>
                                    <TextBlock Style="{StaticResource T.Body}" Text="Steam didn't report Zombie Assault: Resurgence. Pick its folder in Settings."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- loading skeleton -->
                        <StackPanel Margin="0,24,0,0" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
                            <Border Style="{StaticResource Skeleton}"/>
                            <Border Style="{StaticResource Skeleton}"/>
                            <Border Style="{StaticResource Skeleton}"/>
                        </StackPanel>

                        <!-- installed -->
                        <ItemsControl x:Name="ModList" ItemsSource="{Binding Mods}" Margin="0,24,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Style="{StaticResource Panel}" Margin="0,0,0,10" Loaded="Row_Loaded" Opacity="0">
                                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Edge" Background="{StaticResource B.Accent}" CornerRadius="6,0,0,6"/>
                                            <StackPanel x:Name="Body" Grid.Column="1" Margin="20,16,16,16">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}"/>
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource T.Mono}" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                                               Visibility="{Binding Version, Converter={StaticResource Vis}}"/>
                                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="UPDATE" FontFamily="{StaticResource F.Mono}" FontSize="10" Foreground="{StaticResource B.Accent}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" Margin="0,6,0,0" MaxWidth="680" HorizontalAlignment="Left"
                                                           Visibility="{Binding Description, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Mono}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <!-- actions -->
                                            <Grid Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Confirming, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding UpdateCommand}" Height="30" Padding="10,0" Margin="0,0,10,0"
                                                            Content="UPDATE" Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}"
                                                            ToolTip="Replace with the version included with ZARModManager"/>
                                                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding RemoveCommand}" ToolTip="Remove" Margin="0,0,14,0">
                                                        <Path Data="{StaticResource I.Trash}" Style="{StaticResource Path.Icon}" Width="16" Height="16"/>
                                                    </Button>
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Enabled"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Confirming, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Remove this mod?" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding CancelRemoveCommand}" Height="30" Padding="10,0" Margin="0,0,8,0" Content="KEEP"/>
                                                    <Button Style="{StaticResource Btn.Danger}" Command="{Binding RemoveCommand}" Height="30" Padding="10,0" Content="REMOVE"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource B.BorderStrong}"/>
                                            <Setter TargetName="Body" Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- empty library -->
                        <Border Margin="0,6,0,0" Padding="28,30" CornerRadius="6" BorderThickness="1" Background="{StaticResource B.Panel}">
                            <Border.BorderBrush>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Rectangle StrokeDashArray="5 4" Stroke="#3A3E46" StrokeThickness="1" Width="400" Height="100"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.BorderBrush>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMods}" Value="False"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                                <Condition Binding="{Binding GameFound}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Left">
                                <Path Data="{StaticResource I.Upload}" Stroke="{StaticResource B.Accent}" Style="{StaticResource Path.Icon}" Width="22" Height="22" HorizontalAlignment="Left"/>
                                <TextBlock Text="Your library is empty" Style="{StaticResource T.H2}" Margin="0,14,0,4"/>
                                <TextBlock Style="{StaticResource T.Body}" MaxWidth="520"
                                           Text="Drop mod .lua files on this window or use Install Mod. Each mod is downloaded from its own page."/>
                            </StackPanel>
                        </Border>

                        <!-- included with ZARModManager, not installed -->
                        <StackPanel Margin="0,30,0,0" Visibility="{Binding HasAvailable, Converter={StaticResource Vis}}">
                            <TextBlock Text="// INCLUDED WITH ZARMODMANAGER" Style="{StaticResource SectionHead}"/>
                            <ItemsControl ItemsSource="{Binding Available}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Background="Transparent" Padding="20,16">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding InstallCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource I.Download}" Style="{StaticResource Path.Icon}" Width="14" Height="14" Margin="0,0,8,0"/>
                                                        <TextBlock Text="INSTALL" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}" FontSize="15"/>
                                                        <TextBlock Text="{Binding Version}" Style="{StaticResource T.Mono}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,4,0,0" MaxWidth="680" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================================= LOGS -->
                <Grid x:Name="PageLogs" Visibility="Collapsed" Margin="40,34,40,32">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="FOLLOW" Style="{StaticResource T.Mono}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LogFollow}" VerticalAlignment="Center" Margin="0,0,16,0"
                                      ToolTip="Keep reading new lines while the game runs"/>
                            <Button Style="{StaticResource Btn.Icon}" Command="{Binding CopyLogCommand}" ToolTip="Copy the log" Margin="0,0,4,0">
                                <Path Data="{StaticResource I.Copy}" Style="{StaticResource Path.Icon}" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource Btn.Icon}" Command="{Binding OpenModsFolderCommand}" ToolTip="Open the folder">
                                <Path Data="{StaticResource I.Folder}" Style="{StaticResource Path.Icon}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="// DIAGNOSTICS" Style="{StaticResource T.Eyebrow}"/>
                            <TextBlock Text="Loader log" Style="{StaticResource T.Title}" Margin="0,8,0,6"/>
                            <TextBlock Text="ZAMods\loader.log  ·  rewritten each time the game starts" Style="{StaticResource T.Mono}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,22,0,0" Background="#0F1012">
                        <Grid>
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0" Padding="0,8"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource B.TextDim}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="16,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="L" Text="{Binding Text}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource B.TextDim}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Danger}">
                                                <Setter TargetName="L" Property="Foreground" Value="{StaticResource B.Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Warn}">
                                                <Setter TargetName="L" Property="Foreground" Value="{StaticResource B.Accent}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Ok}">
                                                <Setter TargetName="L" Property="Foreground" Value="{StaticResource B.Text}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Margin="28" VerticalAlignment="Top" HorizontalAlignment="Left"
                                        Visibility="{Binding HasLog, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                <TextBlock Text="No log yet" Style="{StaticResource T.H2}"/>
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0" Text="The loader writes its log each time the game starts. Launch once and it appears here."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= SETTINGS -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                    <StackPanel Margin="40,34,40,40" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="// CONFIGURATION" Style="{StaticResource T.Eyebrow}"/>
                        <TextBlock Text="Settings" Style="{StaticResource T.Title}" Margin="0,8,0,26"/>

                        <TextBlock Text="GAME FOLDER" Style="{StaticResource T.Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding DetectGameCommand}" Content="DETECT" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding BrowseGameCommand}" Content="BROWSE" Margin="8,0,0,0"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding GameDirText, Mode=OneWay}" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="12" Foreground="{StaticResource B.TextFaint}" Margin="0,8,0,0"
                                   Text="Found through Steam. Browse only if Steam's location is wrong; Detect goes back to Steam's."/>

                        <Border Height="1" Background="{StaticResource B.Border}" Margin="0,28"/>

                        <TextBlock Text="LOADER RUNTIME" Style="{StaticResource T.Label}"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Ghost}" Command="{Binding InstallRuntimeCommand}" Content="INSTALL / UPDATE" Margin="8,0,0,0"
                                        Visibility="{Binding CanInstallRuntime, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource Btn.Danger}" Command="{Binding RemoveRuntimeCommand}" Content="REMOVE FROM GAME" Margin="8,0,0,0"
                                        Visibility="{Binding CanRemoveRuntime, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource Dot}" Tag="{Binding LoaderTone}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding LoaderStatus}" FontSize="13.5"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="12" Foreground="{StaticResource B.TextFaint}" Margin="0,8,0,0"
                                   Text="The runtime sits in the game folder as version.dll. Removing it starts the game without mods; your mods and their settings stay in ZAMods."/>

                        <Border Height="1" Background="{StaticResource B.Border}" Margin="0,28"/>

                        <TextBlock Text="FOLDERS" Style="{StaticResource T.Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenGameFolderCommand}" Content="GAME FOLDER" Margin="0,0,8,0" IsEnabled="{Binding GameFound}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenModsFolderCommand}" Content="MODS FOLDER" IsEnabled="{Binding GameFound}"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource B.Border}" Margin="0,28"/>

                        <TextBlock Text="ABOUT" Style="{StaticResource T.Label}"/>
                        <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextDim}" LineHeight="20">
                            <Run Text="ZARModManager "/><Run Text="{Binding AppVersion, Mode=OneWay}"/><LineBreak/>
                            <Run Text="Runtime included "/><Run Text="{Binding BundledVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="12" Foreground="{StaticResource B.TextFaint}" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                   Text="ZARModManager is an unofficial, fan-made tool. It is not affiliated with or endorsed by Ninja Kiwi. Mods run inside the game; use them at your own risk."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================================= toasts -->
                <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22" Width="340">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="T" Background="{StaticResource B.Panel2}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,8,0,0" Opacity="0">
                                <Border.RenderTransform><TranslateTransform X="24"/></Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Stripe" Background="{StaticResource B.TextFaint}" CornerRadius="6,0,0,6"/>
                                    <StackPanel Grid.Column="1" Margin="14,11,6,12">
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource F.Display}" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Body}" Style="{StaticResource T.Body}" FontSize="12" LineHeight="17" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Margin="0,6,6,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource I.Close}" Style="{StaticResource Path.Icon}" Width="10" Height="10"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Ok}"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource B.Ok}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Warn}"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource B.Accent}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:Tone.Danger}"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource B.Danger}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ========================================================================= drop target -->
                <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#E60C0D0F" IsHitTestVisible="False">
                    <Border Margin="40" CornerRadius="8" BorderThickness="2" Background="{StaticResource B.AccentSoft}">
                        <Border.BorderBrush>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Rectangle StrokeDashArray="6 4" Stroke="{StaticResource B.Accent}" StrokeThickness="2" Width="400" Height="300"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.BorderBrush>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource I.Download}" Stroke="{StaticResource B.Accent}" StrokeThickness="1.6" Stretch="Uniform" Width="34" Height="34"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Drop to install" Style="{StaticResource T.Title}" FontSize="26" Margin="0,16,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mods (.lua) go into ZAMods" Style="{StaticResource T.Mono}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
