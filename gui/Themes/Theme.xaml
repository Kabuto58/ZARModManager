<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================================== palette ==
         Off-black neutrals, one accent (a muted Helldivers yellow), semantic red / green for status only. -->
    <Color x:Key="C.Bg">#0C0D0F</Color>
    <Color x:Key="C.Sidebar">#101114</Color>
    <Color x:Key="C.Panel">#15171A</Color>
    <Color x:Key="C.Panel2">#1B1D21</Color>
    <Color x:Key="C.Hover">#22252A</Color>
    <Color x:Key="C.Border">#25282D</Color>
    <Color x:Key="C.BorderStrong">#353941</Color>
    <Color x:Key="C.Text">#ECEAE4</Color>
    <Color x:Key="C.TextDim">#A1A5AC</Color>
    <Color x:Key="C.TextFaint">#6C7178</Color>
    <Color x:Key="C.Accent">#EBC944</Color>
    <Color x:Key="C.AccentHover">#F3D661</Color>
    <Color x:Key="C.AccentInk">#16140B</Color>
    <Color x:Key="C.AccentSoft">#1F1C10</Color>
    <Color x:Key="C.Danger">#E06257</Color>
    <Color x:Key="C.DangerSoft">#26161A</Color>
    <Color x:Key="C.Ok">#62C28C</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.Sidebar" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="B.Panel2" Color="{StaticResource C.Panel2}"/>
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}"/>
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}"/>
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.AccentInk" Color="{StaticResource C.AccentInk}"/>
    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.AccentSoft}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.DangerSoft}"/>
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}"/>

    <!-- ===================================================================================== type ==
         Bahnschrift (DIN-like, ships with Windows) for display, Cascadia Mono for labels and numbers. -->
    <FontFamily x:Key="F.Display">Bahnschrift SemiBold, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="T.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ===================================================================================== icons ==
         24 x 24 stroke icons, drawn with Path.Icon (1.6 px, round joins). -->
    <Geometry x:Key="I.Home">M3.5 10.5 L12 3.5 L20.5 10.5 M5.5 9 V20 H18.5 V9 M10 20 V14 H14 V20</Geometry>
    <Geometry x:Key="I.Mods">M12 2.8 L20.5 7.4 V16.6 L12 21.2 L3.5 16.6 V7.4 Z M3.5 7.4 L12 12 L20.5 7.4 M12 12 V21.2</Geometry>
    <Geometry x:Key="I.Logs">M3.5 4.5 H20.5 V19.5 H3.5 Z M7 9 L10 12 L7 15 M12.5 15 H17</Geometry>
    <Geometry x:Key="I.Settings">M4 7 H13 M17 7 H20 M15 5 V9 M4 17 H7 M11 17 H20 M9 15 V19</Geometry>
    <Geometry x:Key="I.Play">M7 4.5 V19.5 L19.5 12 Z</Geometry>
    <Geometry x:Key="I.Download">M12 4 V15 M7 10 L12 15 L17 10 M5 20 H19</Geometry>
    <Geometry x:Key="I.Trash">M4 7 H20 M9 7 V4 H15 V7 M6 7 L7 20 H17 L18 7 M10 11 V16.5 M14 11 V16.5</Geometry>
    <Geometry x:Key="I.Folder">M3.5 6 H9.5 L11.5 8 H20.5 V19 H3.5 Z</Geometry>
    <Geometry x:Key="I.Plus">M12 5 V19 M5 12 H19</Geometry>
    <Geometry x:Key="I.Refresh">M19.5 11 A7.5 7.5 0 1 0 17.3 16.3 M19.5 4.5 V11 H13</Geometry>
    <Geometry x:Key="I.Check">M5 12.5 L10 17 L19 7.5</Geometry>
    <Geometry x:Key="I.Warn">M12 3.5 L21.5 20 H2.5 Z M12 10 V14.5 M12 17 V17.6</Geometry>
    <Geometry x:Key="I.Close">M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5</Geometry>
    <Geometry x:Key="I.Min">M6 12 H18</Geometry>
    <Geometry x:Key="I.Max">M6.5 6.5 H17.5 V17.5 H6.5 Z</Geometry>
    <Geometry x:Key="I.Copy">M8.5 8.5 H19.5 V19.5 H8.5 Z M4.5 15.5 V4.5 H15.5</Geometry>
    <Geometry x:Key="I.Upload">M12 15 V4 M7 9 L12 4 L17 9 M5 20 H19</Geometry>
    <Geometry x:Key="I.Logo">M12 1.8 L21 7 V17 L12 22.2 L3 17 V7 Z</Geometry>
    <Geometry x:Key="I.Bolt">M13.2 5.5 L8 13 H12 L10.8 18.5 L16 11 H12 Z</Geometry>

    <Style x:Key="Path.Icon" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================================================================================== surfaces == -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- a quiet 1px grid, laid over the page background -->
    <DrawingBrush x:Key="B.Grid" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Opacity="0.035">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="1"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="32,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,32"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- hazard stripes, for the launch strip -->
    <DrawingBrush x:Key="B.Hazard" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
        <DrawingBrush.Transform>
            <RotateTransform Angle="45"/>
        </DrawingBrush.Transform>
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource B.AccentSoft}" Geometry="M0,0 H14 V14 H0 Z"/>
                <GeometryDrawing Brush="#2A2614" Geometry="M0,0 H7 V14 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================================================================================== buttons == -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- a small physical push on press -->
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.06"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.06"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource B.AccentInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background">
                    <Setter.Value><SolidColorBrush Color="{StaticResource C.AccentHover}"/></Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource B.Hover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource B.TextFaint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
        <Setter Property="BorderBrush" Value="#4A2A2A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource B.DangerSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource B.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource B.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource B.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================================== navigation ==
         Icon rail: the checked item gets a yellow edge bar and a lifted tile. -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{StaticResource B.Accent}" Opacity="0"
                                CornerRadius="0,2,2,0" Margin="0,12"/>
                        <Border x:Name="Tile" Width="40" Height="40" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource B.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource B.AccentSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================================== switch == -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="{StaticResource B.Hover}"
                            BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource B.TextDim}" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobX"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource B.AccentInk}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================================== inputs == -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource B.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================================== scrollbars ==
         Thin, quiet thumbs; no arrow buttons. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="T" CornerRadius="3" Background="{StaticResource B.BorderStrong}" Margin="2,2"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="T" Property="Background" Value="{StaticResource B.TextFaint}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{StaticResource B.BorderStrong}" Margin="2,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource B.Panel2}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- status dot: a slow breathing pulse while something is live -->
    <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.1">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>
