// The loader's own script (notifications, Mod Settings screen), embedded in the runtime DLL
101 RCDATA "system.lua"

#include "version.h"

// Version information (shown by ZARModManager.exe): the VERSION file, through build\version.h
1 VERSIONINFO
FILEVERSION ZAR_VERSION_RC
PRODUCTVERSION ZAR_VERSION_RC
FILEOS 0x40004
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ZARModManager"
            VALUE "FileDescription", "ZARModManager runtime for Zombie Assault: Resurgence"
            VALUE "FileVersion", ZAR_VERSION
            VALUE "ProductName", "ZARModManager"
            VALUE "ProductVersion", ZAR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
